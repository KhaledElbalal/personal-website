# Studio connection (Sanity CLI reads SANITY_STUDIO_* at build/dev time).
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

# Where the Next.js site runs — Presentation (live preview) loads it in an
# iframe and the reference field checks identifiers against its /api/citation.
SANITY_STUDIO_PREVIEW_ORIGIN=http://localhost:3000

# tldraw license key for the diagram editor. Domain-bound: it must list the
# site's domain, since the site serves the Studio at /studio.
SANITY_STUDIO_TLDRAW_LICENSE_KEY=
