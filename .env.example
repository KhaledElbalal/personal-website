# ── Site ────────────────────────────────────────────────────────────
# Production origin, no trailing slash — used for canonical URLs and
# absolute Open Graph / Twitter image URLs. Falls back to localhost in dev.
NEXT_PUBLIC_SITE_URL=https://khaledibrah.im

# ── Sanity (Next.js site — read side) ──────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Shared secret for the /api/revalidate webhook (server only). Generate a
# random string and set the same value on the Sanity webhook.
SANITY_REVALIDATE_SECRET=



# ── Live preview (Studio → Presentation tool) ──────────────────────
# Read token with Viewer access (sanity.io/manage → API → Tokens). Server only;
# powers Draft Mode so the Studio can preview unpublished drafts on the site.
SANITY_API_READ_TOKEN=
# Where the Studio runs (used for click-to-edit links from the preview).
NEXT_PUBLIC_SANITY_STUDIO_URL=http://localhost:3333
